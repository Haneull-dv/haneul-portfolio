{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": "src",                          // 🔄 src 기준으로 절대경로 설정
    "paths": {
      "@/*": ["*"],                            // eg: @/app/layout.tsx
      "@shared/*": ["shared/*"],               // eg: @shared/lib/fonts
      "@features/*": ["features/*"],           // (선택) 필요 시 추가
      "@components/*": ["shared/components/*"] // (선택) 필요 시 추가
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
